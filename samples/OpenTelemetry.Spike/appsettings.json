{
  "ReverseProxy": {
    "Routes": {
      "hello-route": {
        "ClusterId": "hello-cluster",
        "Match": {
          "Path": "/proxy/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "hello-cluster": {
        "Destinations": {
          "backend-1": {
            "Address": "https://httpbin.org/"
          }
        }
      }
    }
  }
}