<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <TargetFramework>net10.0</TargetFramework>

        <PackageId>Gateway.OpenTelemetry.Yarp</PackageId>

        <Title>Gateway.OpenTelemetry.Yarp</Title>

        <Description>
            YARP integration for Gateway.OpenTelemetry. Adds reverse proxy route, cluster and destination metadata to OpenTelemetry Activities.
        </Description>

        <Authors>Booviper</Authors>

        <Company>Booviper</Company>

        <PackageTags>
            opentelemetry;yarp;reverse-proxy;gateway;observability;tracing
        </PackageTags>

        <RepositoryUrl>
            https://github.com/booviperza/Gateway.OpenTelemetry
        </RepositoryUrl>

        <RepositoryType>git</RepositoryType>

        <PackageProjectUrl>
            https://github.com/booviperza/Gateway.OpenTelemetry
        </PackageProjectUrl>

        <PackageReadmeFile>README.md</PackageReadmeFile>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <PackageIcon>icon.png</PackageIcon>

    </PropertyGroup>

    <ItemGroup>

        <ProjectReference Include="..\Gateway.OpenTelemetry.Core\Gateway.OpenTelemetry.Core.csproj" />

        <ProjectReference Include="..\Gateway.OpenTelemetry.AspNetCore\Gateway.OpenTelemetry.AspNetCore.csproj" />

    </ItemGroup>

    <ItemGroup>

        <PackageReference Include="Yarp.ReverseProxy" />

        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />

    </ItemGroup>

    <ItemGroup>

        <None Include="..\..\README.md" Pack="true" PackagePath="\" />

        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />

    </ItemGroup>

</Project>