{
    "ReverseProxy": {
        "Routes": {
            "route1": {
                "ClusterId": "cluster1",
                "Match": {
                    "Path": "/proxy/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathRemovePrefix": "/proxy"
                    }
                ]
            }
        },
        "Clusters": {
            "cluster1": {
                "Destinations": {
                    "backend1": {
                        "Address": "http://placeholder/"
                    }
                }
            }
        }
    }
}
